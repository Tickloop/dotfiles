# Terminal structure
keybind = alt+backslash=new_split:right
keybind = alt+-=new_split:down
keybind = alt+t=new_tab
keybind = alt+w=close_surface
keybind = alt+d=close_surface

# Navigation
keybind = alt+j=goto_split:next
keybind = alt+k=goto_split:previous

keybind = alt+n=next_tab
keybind = alt+o=previous_tab
keybind = alt+enter=new_window

# visuals
theme = Synthwave
window-theme = ghostty
window-titlebar-background = #000000
window-titlebar-foreground = #dad9c7
window-decoration = client
window-show-tab-bar = auto
gtk-titlebar-style = tabs
gtk-tabs-location = top
gtk-toolbar-style = flat
gtk-wide-tabs = false
gtk-custom-css = ~/.config/ghostty/tabs.css
background-opacity = 0.98
background-blur = 20
font-thicken = true
font-family = FiraCode Nerd Font

split-divider-color = #00FF00
window-padding-x = 10
window-padding-balance = true
unfocused-split-opacity = 0.85
