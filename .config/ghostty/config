# Terminal structure (Karabiner sends these from the shifted F13 layer)
keybind = super+shift+backslash=new_split:right
keybind = super+shift+-=new_split:down
keybind = super+shift+t=new_tab
keybind = super+shift+w=close_surface
keybind = super+d=close_surface

# Navigation
keybind = super+j=goto_split:next
keybind = super+k=goto_split:previous

keybind = super+n=next_tab
keybind = super+o=previous_tab
keybind = super+shift+n=new_window

# visuals
theme = Synthwave
macos-titlebar-style = tabs
background-opacity = 0.98
background-blur = 20
font-thicken = true
font-family = FiraCode Nerd Font

split-divider-color = #00FF00
window-padding-x = 10
window-padding-balance = true
unfocused-split-opacity = 0.85
